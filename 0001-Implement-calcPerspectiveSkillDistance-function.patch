 }
 
+QPointF InputConvertGame::calcPerspectiveSkillDistance(const QPointF &rawPos, const QPointF &centerPos, double ratio) {
+    // Calculate the raw distance from center
+    const QPointF rawDistance{rawPos - centerPos};
+    
+    // Apply perspective transformation based on vertical position
+    // The perspective scale increases as we move down (positive y direction)
+    // This simulates the effect where objects appear larger when closer to the bottom
+    const double perspectiveScale = 0.6 * rawDistance.y() + 1;
+    
+    // Y position factor combines perspective scale with absolute position
+    // This creates a non-linear scaling effect for vertical movement
+    const double yPosFactor = perspectiveScale * rawPos.y();
+    
+    // Calculate the perspective-corrected distance
+    // X distance: divided by ratio and perspective scale for horizontal correction
+    // Y distance: divided by a combination of ratio and yPosFactor for vertical correction
+    // The vertical calculation uses ratio/2 to create asymmetric scaling
+    const QPointF distance{
+        rawDistance.x() / ratio / perspectiveScale,
+        rawDistance.y() / (ratio / 2 + yPosFactor)
+    };
+    
+    return distance;
+}
